# Variables de entorno — FAMAX CONCRETO PERÚ
# Copia este archivo como `.env.local` y completa los valores según sea necesario.
#
# NOTA: El sitio actualmente es 100% estático (formularios via WhatsApp / mailto),
# por lo que no requiere variables obligatorias. Estas son las opcionales que
# podrían añadirse en el futuro (p. ej. al implementar el Libro de Reclamaciones
# con almacenamiento, analíticas o un backend).

# URL pública base del sitio (usada en metadatos/JSON-LD).
NEXT_PUBLIC_SITE_URL=https://www.famaxconcreto.com.pe

# WhatsApp de contacto (solo dígitos con código de país).
NEXT_PUBLIC_WHATSAPP=51973350524

# Correo de contacto (usado en formularios via mailto).
NEXT_PUBLIC_CONTACT_EMAIL=famax@grupoconstructores.com
